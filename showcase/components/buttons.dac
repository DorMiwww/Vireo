block Primary {
    component Default {
        height: 40
        padding: 0 16
        color: #2563EB
        radius: 8

        component Label {
            text: "Button"
            fontSize: 14
            fontWeight: bold
            color: #FFFFFF
        }
    }

    component Small {
        height: 32
        padding: 0 12
        color: #2563EB
        radius: 6

        component Label {
            text: "Button"
            fontSize: 13
            fontWeight: bold
            color: #FFFFFF
        }
    }
}

block Secondary {
