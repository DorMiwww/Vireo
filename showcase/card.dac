import buttons from "./components/buttons.dac"
import badges from "./components/badges.dac"

block Profile {
    component Card {
        width: 380
        backgroundColor: #FFFFFF
        radius: 20
        shadow: true
        layout: vertical
        gap: 0

        // 1. Cover Photo Banner with Stack Layout
        component BannerStack {
            layout: stack
            width: 380
            height: 130
            radius: 20

            component CoverPhoto {
                image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800"
                fit: cover
                width: 380
                height: 130
                radius: 20
                zIndex: 1
            }

            component TintOverlay {
                width: 380
                height: 130
                backgroundColor: #0F172A
                radius: 20
                zIndex: 2
            }

            component ProBadge {
                x: 290
                y: 16
                zIndex: 3
                backgroundColor: #2563EB
                padding: 4 10
                radius: 99
                layout: horizontal
                alignItems: center

                component Text {
                    text: "★ PRO"
                    fontSize: 11
                    fontWeight: bold
                    color: #FFFFFF
                }
            }
        }

        // 2. Card Body Content
        component Body {
            layout: vertical
            gap: 16
            padding: 20
            width: 380

            // Header with Photo Avatar and Name
            component Header {
                layout: horizontal
                gap: 16
                alignItems: center

                component Avatar {
                    image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400"
                    fit: cover
                    width: 60
                    height: 60
                    radius: 99
                    border: 3 #FFFFFF
                    shadow: true
                }

                component UserInfo {
                    layout: vertical
                    gap: 3

                    component NameRow {
                        layout: horizontal
                        gap: 6
                        alignItems: center

                        component Name {
                            text: "Jane Doe"
                            fontSize: 18
                            fontWeight: bold
                            color: #111827
                        }

                        component VerifiedBadge {
                            backgroundColor: #EFF6FF
                            padding: 2 6
                            radius: 99

                            component Check {
                                text: "✓"
                                fontSize: 11
                                fontWeight: bold
                                color: #2563EB
                            }
                        }
                    }

                    component Handle {
                        text: "@janedoe • Design Systems Architect"
                        fontSize: 12
                        color: #6B7280
                    }
                }
            }

            component Bio {
                text: "Design systems architect and UI engineer. Passionate about declarative design tooling, component architectures, and UI synthesis."
                fontSize: 13
                color: #4B5563
            }

            component StatsRow {
                layout: horizontal
                gap: 10
                width: fill

                component StatFollowers {
                    layout: vertical
                    gap: 2
                    padding: 10
                    radius: 8
                    backgroundColor: #F9FAFB
                    width: fill
                    alignItems: center

                    component Number {
                        text: "12.4k"
                        fontSize: 15
                        fontWeight: bold
                        color: #111827
                    }

                    component Label {
                        text: "Followers"
                        fontSize: 11
                        color: #6B7280
                    }
                }

                component StatFollowing {
                    layout: vertical
                    gap: 2
                    padding: 10
                    radius: 8
                    backgroundColor: #F9FAFB
                    width: fill
                    alignItems: center

                    component Number {
                        text: "842"
                        fontSize: 15
                        fontWeight: bold
                        color: #111827
                    }

                    component Label {
                        text: "Following"
                        fontSize: 11
                        color: #6B7280
                    }
                }

                component StatProjects {
                    layout: vertical
                    gap: 2
                    padding: 10
                    radius: 8
                    backgroundColor: #F9FAFB
                    width: fill
                    alignItems: center

                    component Number {
                        text: "38"
                        fontSize: 15
                        fontWeight: bold
                        color: #111827
                    }

                    component Label {
                        text: "Projects"
                        fontSize: 11
                        color: #6B7280
                    }
                }
            }

            component SkillsRow {
                layout: horizontal
                gap: 8

                component Badge1 {
                    ref: badges.Badges.Primary
                    label: "Figma"
                }

                component Badge2 {
                    ref: badges.Badges.Success
                    label: "Vireo DSL"
                }

                component Badge3 {
                    ref: badges.Badges.Neutral
                    label: "Systems"
                }
            }

            component Actions {
                layout: horizontal
                gap: 12
                width: fill

                component FollowBtn {
                    ref: buttons.Primary.Default
                    label: "Follow"
                    width: fill
                }

                component MessageBtn {
                    ref: buttons.Secondary.Default
                    label: "Message"
                    width: fill
                }
            }
        }
    }
}
