block Cards {
    component Card {
        layout: vertical
        mainAxis: hug
        crossAxis: fill
        gap: 12
        padding: 16
        color: #FFFFFF
        radius: 12
        shadow: true

        component Title {
            text: "Card Title"
            fontSize: 18
            fontWeight: bold
            color: #111827
        }

        component Description {
            text: "Card description goes here."
            fontSize: 14
            color: #6B7280
        }

        component Footer {
            layout: horizontal
            mainAxis: fill
            crossAxis: hug
            gap: 8

            component Tag {
                color: #EFF6FF
                radius: 4
                padding: 4 8

                component TagText {
                    text: "New"
                    fontSize: 12
                    color: #3B82F6
                }
            }
        }
    }
}
